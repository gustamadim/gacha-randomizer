#!/bin/sh
# Pre-push guard: run the test suite before anything leaves this repo.
# GitHub Actions is disabled at the account level, so this hook is the local
# CI. To skip for an urgent push: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
if [ -x .venv/bin/python ]; then
  PY=.venv/bin/python
else
  PY=python3
fi
echo "[pre-push] running pytest…"
"$PY" -m pytest -q
